# hw definition file for processing by chibios_hwdef.py
# bootloader for the ST STM32F407G-DISC1 (STM32F4DISCOVERY) development board

# MCU class and specific type
MCU STM32F4xx STM32F407xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID TARGET_HW_PX4_DISCOVERY_V1

# 8MHz crystal (X2)
OSCILLATOR_HZ 8000000

STM32_ST_USE_TIMER 5

FLASH_SIZE_KB 1024

# bootloader lives in sectors 0-1 (32k), parameters in sectors 2-3 (32k)
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 64

# USB first, then USART2 (PA2/PA3) for loading over a USB-serial adapter
SERIAL_ORDER OTG1 USART2

# LD6 (blue) is the bootloader LED, LD4 (green) shows activity
PD15 LED_BOOTLOADER OUTPUT LOW
PD12 LED_ACTIVITY OUTPUT LOW
define HAL_LED_ON 1

# USB OTG FS on CN5
PA9  VBUS INPUT
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

PA2 USART2_TX USART2 NODMA
PA3 USART2_RX USART2 NODMA

# hold B1 (blue user button) during reset to stay in the bootloader
PA0 STAY_IN_BOOTLOADER INPUT
define HAL_STAY_IN_BOOTLOADER_VALUE 1

# keep the on-board LIS3DSH deselected
PE3 LIS3DSH_CS CS
